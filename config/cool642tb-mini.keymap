#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

/*
 * Layers
 *  0 default_layer
 *  1 NUM_ARROW     LANG1 hold
 *  2 TOP           ENTER hold
 *  3 SCROLL        K hold        (trackball = scroll)
 *  4 APP_SWITCH    , hold        (trackball = cmd/alt + tab)
 *  5 VOLUME        I hold        (trackball = volume)
 *  6 WIN           toggled from SCROLL + ;
 *  7 WIN_SCROLL    auto (3 + 6)
 */

&mt {
    flavor = "balanced";
    tapping-term-ms = <300>;
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Left_Click {
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
        };

        Right_Click {
            bindings = <&mkp MB2>;
            key-positions = <19 20>;
        };

        Middle_Click {
            bindings = <&mkp MB3>;
            key-positions = <18 20>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <11 12>;
        };

        Minus {
            bindings = <&kp MINUS>;
            key-positions = <30 31>;
        };

        Plus {
            bindings = <&kp PLUS>;
            key-positions = <31 32>;
        };

        Tilde {
            bindings = <&kp TILDE>;
            key-positions = <30 31>;
            layers = <1>;
        };

        Equal {
            bindings = <&kp EQUAL>;
            key-positions = <31 32>;
            layers = <1>;
        };

        Apostrophe {
            bindings = <&kp SQT>;
            key-positions = <20 21>;
        };

        Grave_Accent {
            bindings = <&kp GRAVE>;
            key-positions = <20 21>;
            layers = <1>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        win_scroll {
            if-layers = <3 6>;
            then-layer = <7>;
        };
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        app_mac: app_mac {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER>,
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_GUI &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };

        app_win: app_win {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER>,
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_ALT &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };

        app_ht_mac: app_ht_mac {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&app_mac>, <&kp>;
        };

        app_ht_win: app_ht_win {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&app_win>, <&kp>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q   &kp W      &kp E         &kp R               &kp T                                                        &kp Y        &kp U  &lt 5 I              &kp O    &kp P
&kp A   &kp S      &kp D         &kp F               &kp G                 &bt BT_CLR        &kp LA(LG(C_POWER))  &kp H        &kp J  &lt 3 K              &kp L    &kp SEMICOLON
&kp Z   &kp X      &kp C         &kp V               &kp B                 &bt BT_SEL 1      &bt BT_SEL 0         &kp N        &kp M  &app_ht_mac 4 COMMA  &kp DOT  &kp SLASH
&trans  &kp LCTRL  &kp LEFT_ALT  &mt LEFT_GUI LANG2  &mt LEFT_SHIFT SPACE  &lt 1 LANG1       &kp BACKSPACE        &lt 2 ENTER                                       &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        NUM_ARROW {
            bindings = <
&kp LCTRL     &kp LEFT_BRACE    &kp UP_ARROW    &kp RBRC           &kp LS(LCTRL)                             &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans
&kp LEFT_ALT  &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT_ARROW    &kp LS(LEFT_ALT)  &trans      &trans      &trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PERCENT
&kp LEFT_GUI  &kp LEFT_BRACKET  &trans          &kp RIGHT_BRACKET  &kp LS(LEFT_GUI)  &trans      &trans      &trans           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD
&trans        &trans            &trans          &trans             &trans            &trans      &kp DELETE  &kp KP_NUMBER_0                                                     &trans
            >;
        };

        TOP {
            bindings = <
&kp F1           &kp F2        &kp F3        &kp F4        &kp F5                           &kp F6        &kp F7         &kp F8        &kp F9                &kp F10
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT  &trans      &trans  &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5       &trans      &trans  &kp NUMBER_6  &kp N7         &kp N8        &kp N9                &kp N0
&trans           &trans        &trans        &trans        &trans       &trans      &trans  &trans                                                           &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp LG(LEFT_ARROW)  &trans  &kp LG(RIGHT_ARROW)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LC(LS(TAB))     &trans  &kp LC(TAB)          &tog 6
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans              &trans  &trans               &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

        APP_SWITCH {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        VOLUME {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        WIN {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans               &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans               &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &app_ht_win 4 COMMA  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                       &trans
            >;
        };

        WIN_SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp LA(LEFT_ARROW)  &trans  &kp LA(RIGHT_ARROW)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans              &trans  &trans               &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans              &trans  &trans               &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };
    };
};
